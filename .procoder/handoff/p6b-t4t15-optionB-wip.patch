+        let bb = fmt16().layout.block_bytes();
+        let l1 = Arc::new(MemTier::new(TierId::L1, 16 * bb, arc.clone()));
+        let l2 = Arc::new(MemTier::new(TierId::L2, 16 * bb, arc));
+        let mut r = rig(16, Some(l1.clone()), Some(l2), clock);
+        r.h.cfg.l1_format = "fp8_e4m3";
