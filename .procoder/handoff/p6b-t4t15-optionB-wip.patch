+        let l1_rate = r.h.transfer.estimate(TransferPath::L1ToL0);
+        assert_eq!(l0.retrieval.seconds, l1_rate.block_seconds(fp8));
+
+        r.h.demote_to(&mut r.pool, 0.0, EvictReason::Pressure);
+        for _ in 0..3 {
+            r.clock.advance(Duration::from_millis(10));
